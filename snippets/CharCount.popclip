// #popclip
// name: Chars
// entitlements: [dynamic]
// module: true
// language: javascript

// runs on every PopClip pop appear
exports.actions = (input /* = popclip.input */) => {
  const chars = input.text.length;             // count characters
  return [{
    // no icon field, will show this title directly on btn vs tooltip.
    title: `${chars} chars`,
    // on click show a transient popup
    code: () => popclip.showText(`Chars: ${chars}`)
  }];
};
